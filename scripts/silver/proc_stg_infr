###Production Dimension & Fact Schema
##This production definition builds out the final dimensional warehouse, leveraging **`project_sk` generated by the historical loading engine**, explicit geography indexes, and your required date structures.


-- 1. TIME INTELLIGENCE DIMENSION (2014-2030)
DROP TABLE IF EXISTS dim_date;
CREATE TABLE dim_date (
    date_sk INT PRIMARY KEY,
    DayOfMonth INT NOT NULL,
    MonthNumber INT NOT NULL,
    MonthName VARCHAR(15) NOT NULL,
    QuarterNumber INT NOT NULL,
    HalfYearNumber INT NOT NULL,
    FiscalMonthNumber INT NOT NULL,
    FiscalQuarterNumber INT NOT NULL,
    WeekOfYear INT NOT NULL,
    Year INT NOT NULL,
    Date DATE NOT NULL,
    DayOfWeekName VARCHAR(15) NOT NULL,
    DateStringKey VARCHAR(30) NOT NULL,
    FinYear VARCHAR(15) NOT NULL,
    CurrentMonthString VARCHAR(3) NOT NULL DEFAULT 'No',
    PreviousMonthString VARCHAR(3) NOT NULL DEFAULT 'No',
    NextMonthString VARCHAR(3) NOT NULL DEFAULT 'No'
);

-- 2. PROJECT DIMENSION (SCD Type 2 Historical Tracking with Row Number Identity Keys)
DROP TABLE IF EXISTS dim_project;
CREATE TABLE dim_project (
    project_sk INT AUTO_INCREMENT PRIMARY KEY, -- Populated via ROW_NUMBER during pipeline run
    project_number VARCHAR(100) NOT NULL,
    change_sequence_number INT NOT NULL,
    project_name VARCHAR(255),
    status_id VARCHAR(100),
    delivery_mechanism VARCHAR(255),
    facility_name VARCHAR(255),
    facility_number VARCHAR(100),
    project_status_id VARCHAR(100),
    idms_gate VARCHAR(255),
    commitment_status_id VARCHAR(100),
    economic_classification VARCHAR(255),
    stage_indicator VARCHAR(100),
    budget_programme VARCHAR(255),
    funding_sources VARCHAR(255),
    nature_of_investment VARCHAR(255),
    row_is_current TINYINT DEFAULT 1,
    row_start_date DATETIME,
    row_end_date DATETIME,
    hash_value VARCHAR(32) NOT NULL,
    INDEX idx_project_perf (project_number, row_is_current)
);

-- 3. LOCATION DIMENSION
DROP TABLE IF EXISTS dim_location;
CREATE TABLE dim_location (
    loc_key INT AUTO_INCREMENT PRIMARY KEY,
    province VARCHAR(100),
    district VARCHAR(100),
    local_municipality VARCHAR(100),
    latitude VARCHAR(50),
    longitude VARCHAR(50),
    UNIQUE KEY uq_location_idx (province, district, local_municipality)
);

-- 4. DEPARTMENT DIMENSION
DROP TABLE IF EXISTS dim_department;
CREATE TABLE dim_department (
    dept_key INT AUTO_INCREMENT PRIMARY KEY,
    sector VARCHAR(100),
    department VARCHAR(255),
    department_group VARCHAR(255),
    vote_number VARCHAR(50),
    vote_name VARCHAR(255),
    UNIQUE KEY uq_dept_idx (vote_number, sector)
);

-- 5. CENTRALIZED DETAILED INFRASTRUCTURE FINANCIAL FACT
DROP TABLE IF EXISTS fact_project_financials;
CREATE TABLE fact_project_financials (
    fact_key INT AUTO_INCREMENT PRIMARY KEY,
    project_sk INT, -- Pointing to structural generation state
    loc_key INT,
    dept_key INT,
    date_sk INT,
    pmis_key_id VARCHAR(100),
    financial_year VARCHAR(50),
    total_project_cost DECIMAL(18,2),
    total_professional_fees DECIMAL(18,2),
    total_construction_fees DECIMAL(18,2),
    total_transfers DECIMAL(18,2),
    total_variation_orders DECIMAL(18,2),
    total_projected_expenditure DECIMAL(18,2),
    total_actual_expenditure DECIMAL(18,2),
    total_revised_expenditure DECIMAL(18,2),
    available_budget DECIMAL(18,2),
    under_over_spending DECIMAL(18,2),
    load_timestamp DATETIME,
    
    FOREIGN KEY (project_sk) REFERENCES dim_project(project_sk),
    FOREIGN KEY (loc_key) REFERENCES dim_location(loc_key),
    FOREIGN KEY (dept_key) REFERENCES dim_department(dept_key),
    FOREIGN KEY (date_sk) REFERENCES dim_date(date_sk)
);
